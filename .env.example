# Sunucu
PORT=3000
HOST=0.0.0.0
# Üretimde production yapın (Secure çerez + HSTS, SESSION_SECRET zorunlu)
NODE_ENV=development

# En az 32 karakter rastgele değer. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite veritabanı dosyası
DB_PATH=./data/site-app.sqlite

# Platform yöneticisi (satıcı) telefonları, virgülle ayrılmış. Bu numaralar siteye katılamaz.
PLATFORM_ADMIN_TELEFONLARI=+905000000099

# Ters vekil (Nginx vb.) arkasındaysanız 1 yapın: X-Forwarded-For / X-Forwarded-Proto okunur
TRUST_PROXY=0
# Dışarıdan görünen adres (CSRF Origin kontrolü için önerilir), ör. https://sakin.ornek.com
PUBLIC_ORIGIN=

# SMS sağlayıcı: konsol (geliştirme; kod loga yazılır) | webhook | netgsm
SMS_PROVIDER=konsol
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
NETGSM_KULLANICI=
NETGSM_SIFRE=
NETGSM_BASLIK=
# Yalnızca kapalı test ortamı için: üretimde konsol SMS'e izin ver (önerilmez)
ALLOW_CONSOLE_SMS=0

# --- Mağaza aboneliği (docs/MAGAZA.md) — üçüncü taraf hizmet yok ---
# Apple Root CA - G3 dosyası (https://www.apple.com/certificateauthority/AppleRootCA-G3.cer). Boşsa iOS satın alma kapalı.
APPLE_KOK_SERTIFIKA=
APPLE_BUNDLE_ID=com.bilinclisakin.app
# Google Play Developer API hizmet hesabı JSON dosyası. Boşsa Android satın alma kapalı.
GOOGLE_HIZMET_HESABI=
GOOGLE_PAKET_ADI=com.bilinclisakin.app
# Pub/Sub itme adresindeki ?anahtar= değeri
GOOGLE_BILDIRIM_ANAHTARI=
ABONELIK_FIYAT_METNI=100 TL / ay
# Mağaza inceleme hesabı (SMS'siz giriş; inceleme bitince kaldırın)
INCELEME_TELEFON=
INCELEME_KODU=
